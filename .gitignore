# Hugo 빌드 산출물 (CF Pages가 빌드하므로 커밋 불필요)
/public/
/resources/
.hugo_build.lock

# 작업용 임시 파일
new_idioms*.json
fetch_*.log

# 작업용 데이터(사이트 콘텐츠 아님, 자동 업로드 제외)
/_localdata/

# 로컬 전용 Claude 설정·자동화 스크립트
.claude/settings.local.json
.claude/auto-upload.sh
__pycache__/

# 리딩맵: 원본 기출 PDF·키는 저장소에 넣지 않는다 (공개 저장소)
/원본자료/
.env

# 기출 작업물: 지문 전문 게시 여부를 정하기 전까지 원문이 든 파일은 올리지 않는다 (도구·만들기 스크립트·검토 보고서만)
/작업/**/*.png
/작업/**/*.json
/작업/**/*_글자.txt
/작업/**/*.html
