# Hugo 빌드 산출물 (CF Pages가 빌드하므로 커밋 불필요)
/public/
/resources/
.hugo_build.lock

# 작업용 임시 파일
new_idioms*.json
fetch_*.log

# 작업용 데이터(사이트 콘텐츠 아님, 자동 업로드 제외)
/_localdata/

# 로컬 전용 Claude 설정·자동화 스크립트
.claude/settings.local.json
.claude/auto-upload.sh
__pycache__/

# 리딩맵: 원본 기출 PDF·키는 저장소에 넣지 않는다 (공개 저장소)
/원본자료/
.env

# 기출 작업물: 세트 JSON·그림 조각·만들기 스크립트·검토 보고서는 올린다(지문 전문 게시 결정 2026-11-24).
# 다시 만들 수 있는 것(쪽 전체 그림·PDF 글자 덤프·초안·미리보기)은 올리지 않는다.
/작업/**/문제_*.png
/작업/**/*_글자.txt
/작업/**/초안_*.json
/작업/**/미리보기_*.html
