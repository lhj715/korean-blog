{{- $list := slice -}}
{{- range where site.RegularPages "Section" "in" (slice "literature" "grammar" "exams") -}}
  {{- $genre := "" -}}{{- with .Params.genres }}{{ $genre = delimit . " " }}{{ end -}}
  {{- $author := "" -}}{{- with .Params.authors }}{{ $author = delimit . " " }}{{ end -}}
  {{- $list = $list | append (dict
      "title" .Title
      "url" .RelPermalink
      "section" .Section
      "genre" $genre
      "author" $author
      "summary" (or .Params.summary "")
  ) -}}
{{- end -}}
{{- range hugo.Data.idioms -}}
  {{- $list = $list | append (dict
      "title" .word
      "url" (printf "%s#%s" (relURL "/idioms/") .word)
      "section" "idioms"
      "genre" .hanja
      "author" ""
      "summary" .meaning
  ) -}}
{{- end -}}
{{- $list | jsonify -}}
